{ "builders": [ {
  "type": "virtualbox-ovf",
  "format": "ovf",
  "source_path": "/home/odintsov/image/fastnetmon-ubuntu-18.04-amd64.ovf",
  "ssh_username": "fastnetmon",
  "ssh_password": "fastnetmon",
  "guest_additions_mode": "disable",
  "shutdown_command": "sudo shutdown -P now",
  "vboxmanage": [
    ["showvminfo", "{{.Name}}"],
    ["modifyvm", "{{.Name}}", "--memory", "2048"],
    ["modifyvm", "{{.Name}}", "--cpus", "2"],
    ["modifyvm", "{{.Name}}", "--nic1", "nat"]
  ]
} ],

 "provisioners": [
  {
      "type": "shell",
      "execute_command": "echo 'fastnetmon' | sudo -S sh -c '{{ .Vars }} {{ .Path }}'",
      "inline_shebang": "/bin/bash -e",
      "inline": [
	    "sleep 30",
        "useradd -m --shell /bin/bash flowdetector",
        "echo -e \"flowdetector\\nflowdetector\" | passwd flowdetector",
        "echo 'flowdetector' | sudo tee /etc/hostname",
        "echo 'flowdetector ALL=(ALL:ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/flowdetector",
	    "echo 'fastnetmon ALL=(ALL:ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/fastnetmon",
        "sleep 30",
	    "echo -e \"network:\\n  version: 2\\n  ethernets:\\n    eth0:\\n      dhcp4: true\\n\" | sudo tee /etc/netplan/99-eth0-static.yaml",
        "apt-get update",
        "apt-get install -y e2fsprogs open-vm-tools",
        "resize2fs /dev/mapper/ubuntu--vg-ubuntu--lv",
        "apt-get upgrade -y",
        "apt-get clean",
        "apt-get install -y apt-transport-https libssl1.0.0 iproute2 git cloud-init gdb",
        "wget https://install.fastnetmon.com/installer -Oinstaller",
        "sudo chmod +x installer",
        "./installer -do_not_check_license",
        "apt-get install -y --allow-downgrades fastnetmon=2.0.276", 
        "fcli set main ban_time 30",
        "fcli set main enable_ban enable",
        "fcli set main enable_ban_ipv6 enable",
        "fcli set main enable_total_hostgroup_counters enable",
        "fcli set main build_total_hostgroups_from_per_host_hostgroups enable",
        "fcli set main keep_blocked_hosts_during_restart enable",
        "fcli set hostgroup global_total",
        "fcli set hostgroup global_total calculation_method total",
        "fcli set main notify_script_enabled enable",
        "fcli set main notify_script_format json",
        "fcli set main notify_script_path /opt/fastnetmon/libraries/radware_plugin/radware_notify_script",
        "fcli set main notify_script_hostgroup_enabled enable",
        "fcli set main notify_script_hostgroup_path /opt/fastnetmon/libraries/radware_plugin/radware_notify_script",
	    "echo '{\"log_path\":\"/var/log/fastnetmon/fastnetmon_radware_go_notify_script.log\", \"vision_ip\":\"192.168.1.38\", \"vision_username\": \"radware\", \"vision_password\":\"radware\", \"skip_source_networks\": true, \"skip_ssl_verification\":true}' | sudo tee /etc/fastnetmon_radware.json",
        "sudo ./installer -install_graphic_stack",
        "sleep 30",
        "apt-get clean",
        "rm /etc/nginx/.htpasswd",
        "rm /etc/clickhouse-server/users.d/admin.xml",
        "cp /dev/null /var/log/fastnetmon/fastnetmon.log",
        "cp /dev/null /var/log/fastnetmon/traffic_db.log",
        "cp /dev/null /var/log/fastnetmon/api_gateway.log",
        "cp /dev/null /var/log/auth.log",
        "cp /dev/null /var/log/kern.log",
        "cp /dev/null /var/log/dpkg.log",
        "cp /dev/null /var/log/cloud-init.log",
        "cp /dev/null /var/log/alternatives.log",
        "cp /dev/null /var/log/cloud-init.log",
        "rm -f /etc/fastnetmon/license.lic",
        "rm /root/.ssh/authorized_keys",
        "cloud-init clean",
        "sed -i 's/GRUB_CMDLINE_LINUX=\"\"/GRUB_CMDLINE_LINUX=\"net.ifnames=0 biosdevname=0\"/' /etc/default/grub",
        "update-grub2",
        "usermod -L fastnetmon",
	    "passwd -l fastnetmon",
	    "usermod --expiredate 1 fastnetmon",
        "apt-mark hold fastnetmon"
    ]
    }
 ]
}
